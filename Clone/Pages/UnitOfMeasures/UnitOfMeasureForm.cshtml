@page
@model Indotalent.Pages.UnitOfMeasures.UnitOfMeasureFormModel
@{
    Layout = "~/Pages/Shared/AdminLTE/_Admin.cshtml";
    ViewData["Title"] = Model.ActionMode == "edit" ? "Edit Unit" : "Create Unit";
}

<div class="row mb-3">
    <div class="col-12">
        <a href="/UnitOfMeasures/UnitOfMeasureList" class="btn btn-secondary btn-sm mb-3">
            <i class="fas fa-arrow-left mr-1"></i> Back
        </a>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle mr-1"></i> Please check the information below.
                <div asp-validation-summary="All" class="mt-2 mb-0"></div>
            </div>
        }

        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-balance-scale mr-1"></i> @(Model.ActionMode == "edit" ? "Edit Unit" : "Create Unit")
                </h3>
            </div>
            <form method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Form.RecId" />

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Unit Code (Symbol)</label>
                                <input asp-for="Form.Symbol" class="form-control" maxlength="20"
                                       readonly="@(Model.ActionMode == "edit")" />
                                <span asp-validation-for="Form.Symbol" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Decimal Precision</label>
                                <input asp-for="Form.DecimalPrecision" class="form-control" type="number" min="0" max="4" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Unit Class</label>
                                <input asp-for="Form.UnitOfMeasureClass" class="form-control" type="number" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>System Group</label>
                                <input asp-for="Form.SystemOfUnits" class="form-control" type="number" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save mr-1"></i> @(Model.ActionMode == "edit" ? "Update" : "Create")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}