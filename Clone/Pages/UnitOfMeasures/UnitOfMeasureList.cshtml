@page
@using System.Text.Json
@model Indotalent.Pages.UnitOfMeasures.UnitOfMeasureListModel
@{
    Layout = "~/Pages/Shared/AdminLTE/_Admin.cshtml";
    ViewData["Title"] = "Unit of Measure List";
    var dataJsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = null };
    var columnJsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}
@Html.AntiForgeryToken()
<div class="row mb-3">
    <div class="col-12">
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="fas fa-info-circle mr-1"></i> @Model.StatusMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-balance-scale mr-1"></i> Unit of Measure</h3>
            </div>
            <div class="card-body">
                <div id="Grid"></div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var grid;
        var columns = @Html.Raw(JsonSerializer.Serialize(Model.GridColumns, columnJsonOptions));
        var data = @Html.Raw(JsonSerializer.Serialize(Model.UnitList, dataJsonOptions));
        document.addEventListener('DOMContentLoaded', function () {
            grid = AppGrid.create({
                gridId: 'Grid',
                dataSource: data,
                columns: columns,
                keyField: 'RecId',
                formUrl: '/UnitOfMeasures/UnitOfMeasureForm',
                idParamName: 'recId',
                actions: { excelExport: true, search: true, refresh: true, add: true, edit: true, delete: true },
                enableCheckbox: true,
                deleteUrl: '/UnitOfMeasures/UnitOfMeasureList?handler=Delete',
                onRefresh: function () { window.location.reload(); },
                onDeleted: function () { window.location.reload(); },
                openEditOnDoubleClick: true
            });
        });
    </script>
}