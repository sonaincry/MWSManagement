@using Indotalent.Applications.Companies
@inject AspNetCompanyService CompanyService
@{
    var defaultCompany = await CompanyService.GetDefaultCompanyAsync();
    var companyName = defaultCompany?.Name ?? string.Empty;
    var companyWeb = defaultCompany?.Website ?? "#";
    var year = DateTime.Now.Year;
}

<footer class="main-footer">
    <div class="float-right d-none d-sm-block">
        <b>Developed By:</b> <a href="https://rgt.com">https://rgt.com</a>
    </div>
    <strong>Copyright &copy; @year <a href="@companyWeb">@companyName</a>.</strong> All rights reserved.
</footer>

