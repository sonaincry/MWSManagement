@page
@using System.Text.Json
@model Indotalent.Pages.Customers.CustomerLoyaltyListModel
@{
    Layout = "~/Pages/Shared/AdminLTE/_Admin.cshtml";
    ViewData["Title"] = "Loyalty Members";
    var dataJsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = null };
    var columnJsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}
@Html.AntiForgeryToken()

<div class="row">
    <div class="col-12">
        <div class="card card-primary card-outline">
            <div class="card-body">
                <div id="Grid"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var grid;
        var columns = @Html.Raw(JsonSerializer.Serialize(Model.GridColumns, columnJsonOptions));
        var data = @Html.Raw(JsonSerializer.Serialize(Model.CustomerList, dataJsonOptions));

        document.addEventListener('DOMContentLoaded', function () {
            grid = AppGrid.create({
                gridId: 'Grid',
                dataSource: data,
                columns: columns,
                keyField: 'AccountNum',
                formUrl: '/Customers/CustomerLoyaltyForm',
                idParamName: 'accountNum',
                actions: {
                    excelExport: true,
                    search: true,
                    refresh: true,
                    add: true,
                    edit: true,
                    delete: true
                },
                enableCheckbox: true,
                deleteUrl: '/Customers/CustomerLoyaltyList?handler=Delete',
                onRefresh: function () { window.location.reload(); },
                onDeleted: function () { window.location.reload(); },
                openEditOnDoubleClick: true
            });
        });
    </script>
}