                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Details</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Details</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Details</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Details</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Details</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Details</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Details</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>

                                <div class="detail-item">
                                    <span class="detail-label">Attachments (0)</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                            </div>

                            <!-- ===== DIVIDER ===== -->
                            <hr class="detail-divider" />

                            <!-- ===== ITEM STATUS ===== -->
                            <div class="detail-section">
                                <div class="detail-section-header">
                                    <i class="fas fa-chart-bar mr-1"></i>Item status
                                </div>

                                <div class="detail-item">
                                    <span class="detail-label">Item No.</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Company Code</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Product ID</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Product Name</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Barcode Identification</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Sales Price (VND)</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Sales Price</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Extended Description</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Extended Description</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Extended Description</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Extended Description</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Extended Description</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>

                                <div class="detail-item">
                                    <span class="detail-label">Extended Description</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Extended Description</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Extended Description</span>
                                    <span class="detail-value" title="No data">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<partial name="~/Pages/Shared/_ConfirmDeleteModal.cshtml" />
<partial name="_ValidationScriptsPartial" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.FormActionCommon) {
                FormActionCommon.initDeleteConfirm({
                    formId: 'formMain',
                    deleteButtonId: 'btnDelete',
                    url: '/Products/ProductDetail',
                    title: 'Delete item',
                    message: 'Are you sure you want to delete this item?',
                    getParams: function () {
                        return {
                            productId: '@Model.Product.ProductId',
                            companyCode: '@Model.Product.CompanyCode'
                        };
                    }
                });
            } else {
                console.error('FormActionCommon is not loaded.');
            }
        });
    </script>
}