@page
@model Indotalent.Pages.TaxVatNums.TaxVatNumTableFormModel

@{
    Layout = "~/Pages/Shared/AdminLTE/_Admin.cshtml";
    ViewData["Title"] = "Tax VAT Number";

    var isCreate = Model.ActionMode == "create";
    var isEdit = Model.ActionMode == "edit";
    var isDelete = Model.ActionMode == "delete";
}

<div class="row mb-3">
    <div class="col-12">

        <a href="/TaxVatNums/TaxVatNumTableList" class="btn btn-secondary btn-sm mb-3">
            <i class="fas fa-arrow-left mr-1"></i> Back to List
        </a>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle mr-1"></i>
                Please check the information below.

                <div asp-validation-summary="All" class="mt-2 mb-0"></div>

                <button type="button" class="close" data-dismiss="alert" aria-label="Close" >
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <form id="formMain" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="card card-primary card-outline">

                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">
                            <i class="fas fa-box-open mr-1"></i> Vat number
                        </h3>
                    </div>

                    <hr class="detail-divider" />

                    <div class="action-buttons">
                        @if (isEdit)
                        {
                            <button type="button" id="btnDelete" class="btn btn-danger btn-sm px-3">
                                <i class="fas fa-trash mr-1"></i> Delete
                            </button>
                        }

                        <button type="submit" class="btn btn-primary btn-sm px-3">
                            <i class="fas fa-save mr-1"></i>
                            @(isCreate ? "Create" : isEdit ? "Update" : " ")
                        </button>
                    </div>
                </div>

                <input type="hidden" asp-for="Form.RecId" />

                <div style="overflow-y: auto; flex: 1;">

                    <div class="card-body">
                        <div class="row">

                            @if (!isCreate)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>RecId</label>
                                        <input asp-for="Form.RecId" class="form-control" readonly />
                                    </div>
                                </div>
                            }

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Company</label>
                                    <input asp-for="Form.DataAreaId" class="form-control" maxlength="4" />
                                    <span asp-validation-for="Form.DataAreaId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Country Region</label>
                                    <input asp-for="Form.CountryRegionId" class="form-control" maxlength="10" />
                                    <span asp-validation-for="Form.CountryRegionId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>VAT Number</label>
                                    <input asp-for="Form.VatNum" class="form-control" maxlength="20" />
                                    <span asp-validation-for="Form.VatNum" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Name</label>
                                    <input asp-for="Form.Name" class="form-control" maxlength="60" />
                                    <span asp-validation-for="Form.Name" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<partial name="~/Pages/Shared/_ConfirmDeleteModal.cshtml" />
<partial name="_ValidationScriptsPartial" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.FormActionCommon) {
                FormActionCommon.initDeleteConfirm({
                    formId: 'formMain',
                    deleteButtonId: 'btnDelete',
                    url: '/TaxVatNums/TaxVatNumTableForm',
                    title: 'Delete item',
                    message: 'Are you sure you want to delete this item?',
                    getParams: function () {
                        return {
                            recId: '@Model.Form.RecId'
                        };
                    }
                });
            } else {
                console.error('FormActionCommon is not loaded.');
            }
        });
    </script>
}