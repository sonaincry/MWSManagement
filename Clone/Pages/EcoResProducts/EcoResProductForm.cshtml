@page
@model Indotalent.Pages.EcoResProducts.EcoResProductFormModel

@{
    Layout = "~/Pages/Shared/AdminLTE/_Admin.cshtml";
    ViewData["Title"] = Model.ActionMode == "edit" ? "Edit Product" : "Create Product";
}

<div class="row mb-3">
    <div class="col-12">

        <a href="/EcoResProducts/EcoResProductList" class="btn btn-secondary btn-sm mb-3">
            <i class="fas fa-arrow-left mr-1"></i> Back
        </a>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle mr-1"></i> @Model.StatusMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle mr-1"></i>
                Please check the information below.
                <div asp-validation-summary="All" class="mt-2 mb-0"></div>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="card card-primary card-outline">
            <h3 class="card-title">
                <i class="fas fa-box mr-1"></i> @(Model.ActionMode == "edit" ? "Edit Product" : "Create Product")
            </h3>

            <form method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Form.RecId" />
                <div class="card-body">
                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Product Name</label>
                                <input asp-for="Form.SearchName" class="form-control" maxlength="40" />
                                <span asp-validation-for="Form.SearchName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Product Type</label>
                                <select asp-for="Form.ProductType" class="form-control">
                                    <option value="1">Item</option>
                                    <option value="2">Service</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Category</label>
                                <select asp-for="Form.CategoryRecId" class="form-control" id="categorySelect">
                                    <option value="">-- None --</option>
                                    @foreach (var c in Model.CategoryOptions)
                                    {
                                        <option value="@c.CategoryRecId" data-hierarchy="@c.CategoryHierarchyRecId">
                                            @c.Name
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <input type="hidden" asp-for="Form.CategoryHierarchyRecId" id="categoryHierarchyHidden" />

                    </div>
                </div>

                <div class="card-footer d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save mr-1"></i> @(Model.ActionMode == "edit" ? "Update" : "Create")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('categorySelect').addEventListener('change', function () {
            var selected = this.options[this.selectedIndex];
            var hierarchy = selected.getAttribute('data-hierarchy') || '';
            document.getElementById('categoryHierarchyHidden').value = hierarchy;
        });
    </script>
}